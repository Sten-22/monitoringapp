import psutil
import matplotlib.pyplot as plt
import time
from datetime import datetime

# Data lijsten
x_data = []
cpu_data = []
ram_data = []

plt.ion()
fig, (ax_cpu, ax_ram) = plt.subplots(2, 1, figsize=(10, 8))

start_time = time.time()

with open("cpu_log.txt", "a+") as cpu_log, open("ram_log.txt", "a+") as ram_log:

    while True:
        cpu = psutil.cpu_percent(interval=1)
        ram = psutil.virtual_memory().percent
        
        timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")

        # Logging (blijft hetzelfde)
        cpu_log.write(f"{timestamp} | CPU: {cpu}%\n")
        cpu_log.flush()

        ram_log.write(f"{timestamp} | RAM: {ram}%\n")
        ram_log.flush()

        print(f"{timestamp} | CPU: {cpu}% | RAM: {ram}%")


#lezen uit de log file ipv psutil
        cpu_log.seek(0)
        ram_log.seek(0)

        cpu_lines = cpu_log.readlines()
        ram_lines = ram_log.readlines()

        x_data.clear()
        cpu_data.clear()
        ram_data.clear()

        for i, line in enumerate(cpu_lines):
            try:
                value = float(line.split("CPU: ")[1].replace("%", "").strip())
                cpu_data.append(value)
                x_data.append(i)
            except:
                pass

        for line in ram_lines:
            try:
                value = float(line.split("RAM: ")[1].replace("%", "").strip())
                ram_data.append(value)
            except:
                pass

        #CPU
        ax_cpu.clear()
        ax_cpu.set_title("Live CPU Monitor")
        ax_cpu.set_xlabel("Tijd in seconden")
        ax_cpu.set_ylabel("CPU (%)")

        for i in range(1, len(x_data)):
            if cpu_data[i] <= 5:
                color = "green"
            elif cpu_data[i] <= 10:
                color = "yellow"
            elif cpu_data[i] <= 30:
                color = "orange"
            else:
                color = "red"

            ax_cpu.plot(x_data[i-1:i+1], cpu_data[i-1:i+1], color=color)

        # CPU Legenda
        cpu_legend = [
            ('green', '≤5% CPU'),
            ('yellow', '5–10% CPU'),
            ('orange', '10–30% CPU'),
            ('red', '>30% CPU')
        ]
        cpu_lines = [plt.Line2D([0], [0], color=c, lw=2) for c, _ in cpu_legend]
        ax_cpu.legend(cpu_lines, [label for _, label in cpu_legend], loc="upper right")

        #RAM
        ax_ram.clear()
        ax_ram.set_title("Live RAM Monitor")
        ax_ram.set_xlabel("Tijd in seconden")
        ax_ram.set_ylabel("RAM (%)")
        
        for i in range(1, len(x_data)):
            if ram_data[i] <= 30:
                color = "green"
            elif ram_data[i] <= 60:
                color = "yellow"
            elif ram_data[i] <= 80:
                color = "orange"
            else:
                color = "red"

            ax_ram.plot(x_data[i-1:i+1], ram_data[i-1:i+1], color=color)

        # RAM Legenda
        ram_legend = [
            ('green', '≤30% RAM'),
            ('yellow', '30–60% RAM'),
            ('orange', '60–80% RAM'),
            ('red', '>80% RAM')
        ]
        ram_lines = [plt.Line2D([0], [0], color=c, lw=2) for c, _ in ram_legend]
        ax_ram.legend(ram_lines, [label for _, label in ram_legend], loc="upper right")

        plt.tight_layout()
        plt.pause(0.1)



